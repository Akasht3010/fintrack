{
  "name": "fintrack",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --go --lan",
    "start:tunnel": "expo start --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "deploy": "npx expo export -p web && wrangler deploy",
    "preview": "npx expo export -p web && wrangler dev",
    "update:preview": "eas update --branch preview --environment preview",
    "update:production": "eas update --branch production --environment production",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --forceExit"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@tanstack/react-query": "^5.99.2",
    "axios": "^1.15.1",
    "babel-preset-expo": "~57.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "decimal.js": "^10.6.0",
    "expo": "^57.0.20",
    "expo-auth-session": "~57.0.11",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-modules-core": "^57.0.16",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.21",
    "expo-web-browser": "~57.0.2",
    "nativewind": "^4.2.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^2.6.1",
    "zustand": "^5.0.12"
