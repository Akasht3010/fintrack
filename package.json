    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.4",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "tailwindcss": "^3.3.2",
    "typescript": "~6.0.3",
    "wrangler": "^4.124.0"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 30000,
    "setupFiles": [
      "./jest.setup.js"
    ]
  }
