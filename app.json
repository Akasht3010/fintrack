{
  "expo": {
    "name": "Fintrack",
    "slug": "fintrack",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fintrack.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.fintrack.app",
      "permissions": [
        "android.permission.READ_SMS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "scheme": "fintrack",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://fintrack-api-proxy.fintrack-proxy.workers.dev",
      "googleClientIdWeb": "989422306373-vjomjm06cfj8p4efvm98qp4acd6bsagg.apps.googleusercontent.com",
      "appEnv": "production",
      "router": {},
      "eas": {
        "projectId": "5853c639-7a2d-4e22-99df-5aed7584de13"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5853c639-7a2d-4e22-99df-5aed7584de13"
    }
  }
}
