{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    // TS 6 deprecates `baseUrl` (removed in TS 7). The `paths` above are all
    // relative, so they'll keep resolving off this file's dir once baseUrl
    // is dropped — silence the deprecation for now, remove baseUrl on the
    // next tsconfig cleanup.
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@app/*": [
        "app/*"
      ],
      "@assets/*": [
        "assets/*"
      ]
    },
    "plugins": [
      {
        "name": "expo/typescript-plugin"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.d.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    ".expo/types/**/*.ts"
  ],
  // Jest runs *.test.ts(x) through babel-jest, which strips types without
  // checking them, so excluding these from `tsc --noEmit` doesn't weaken
  // actual test coverage. It sidesteps a real gap instead: @types/jest
  // (current up to 30.0.0) doesn't yet have a fix for TS 6's stricter
  // handling of ambient namespace declarations, which turns every jest.*
  // global (jest.mock, describe, it, expect, …) into a "cannot use
  // namespace as a value" error under this project's TS ~6.0.3.
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
